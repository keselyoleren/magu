# Port host untuk container; ubah bila 5432/6379 sudah dipakai di mesin ini.
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgres://magu:magu@127.0.0.1:5432/magu?sslmode=disable&timezone=Asia/Jakarta
TEST_DATABASE_URL=postgres://magu:magu@127.0.0.1:5432/magu_test?sslmode=disable&timezone=Asia/Jakarta
REDIS_URL=redis://127.0.0.1:6379/0
LISTEN_ADDR=127.0.0.1:8080

# Nama toko dan lebar kertas struk: 32 karakter untuk 58 mm, 48 untuk 80 mm.
STORE_NAME=Toko
# Awalan barcode untuk barang milik toko (barang titipan memakai kode membernya).
STORE_CODE=TK
RECEIPT_WIDTH=32
# Kosong = cetak dimatikan. Lihat docs/deployment.md bagian 1.
PRINTER_TARGET=
# Kosong = QRIS dimatikan. Produksi: MIDTRANS_BASE_URL=https://api.midtrans.com
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
# Kosong = kirim laporan ke Google Drive dimatikan. Lihat docs/deployment.md bagian Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
